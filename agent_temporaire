            if      ( myBeliefs.playerPosition.x == p.x-1 && myBeliefs.playerPosition.y == p.y )
                await socket.emitMove('right');
            else if ( myBeliefs.playerPosition.x == p.x+1 && myBeliefs.playerPosition.y == p.y )
                await socket.emitMove('left')
