// ─── Configuration 

const TOKEN = process.env.TOKEN;
const HOST = process.env.HOST;

/** Hard-coded map dimensions for probability calculations. */
const MAX_TIME_HORIZON = 5; // Number of moves ahead to predict
const MAX_AGENTS = 50; // Maximum number of agents to track

// ***************************************************************************
// Beliefs classe
// ***************************************************************************

/**
 * Class representing the agent's beliefs.
 */
class Beliefs {
    constructor() {
        /** @type {{ x: number, y: number }} Player's current position. */
        this.playerPosition = { x: 0, y: 0 };

        /** Set (instead a list) of parcels currently carried.  
         * @type {Set<{ id: string }>} Items the player is carrying. */
        this.carried = new Set();

        /**
         * List of parcels seen on the map.
         * @type {Array<{ id: string, x: number, y: number, carriedBy: string, reward: number }>}
         */
        this.visibleParcels = [];

        /**
         * List of agents seen on the map.
         * @type {Array<{ id: string, x: number, y: number }>}
         */
        this.visibleAgents = [];

        /**
         * Probability map: for each position, time step, and agent, probability of being there.
         * Dimensions: [x][y][time][agentIndex]
         * @type {Array<Array<Array<Array<number>>>>}
         */
        this.probabilityMap = Array.from({ length: this.mapWidth }, () =>
            Array.from({ length: this.mapHeight }, () =>
                Array.from({ length: MAX_TIME_HORIZON }, () =>
                    Array(MAX_AGENTS).fill(0)
                )
            )
        );
        
        // ------------------------------------------------------------------
        // Belief attributes
        // ------------------------------------------------------------------
        /**
         * Delivery point location, set on map event.
         * @type {Array<{ x: number, y: number, distance: number }>}
         */
        this.deliveryPoint = []; // Delivery point, will be set on map event

        /**
         * Spawn point location, set on map event.
         * @type {Array<{ x: number, y: number }>}
         */
        this.spawnPoint = []; // Spawn point, will be set on map event

        /**
         * Tiles of the map, set on map event.
         * @type {Array<number>}
         */
        this.tiles = []; // Map tiles, will be set on map event

        /** Map dimensions, set on map event.
         * @type {number} 
         */
        this.mapWidth = 0; 

        /** Map dimensions, set on map event.
         * @type {number} 
         */
        this.mapHeight = 0; 
        
    }

    //-------------------------------------------------------------------------
    // Beliefs methods (update, define, etc.)
    //-------------------------------------------------------------------------
    /**
     * Updates the player's position.
     * @param {number} x
     * @param {number} y
     */
    updatePlayerPosition(x, y) {
        this.playerPosition = { x, y };
    }

    /**
     * Adds a parcel to the carried set. (set is used to avoid duplicates)
     * @param {string} parcelID
     */
    addCarriedParcel(parcelID) {
        // add the just picked up new parcel ids to the carried set
        this.carried.add(parcelID);
    }

    /**
     * Updates visible parcels.
     * @param {Array<{ id: string, x: number, y: number, carriedBy: string, reward: number }>} parcels
     */
    updateVisibleParcels(parcels) {
        // visible parcels = not already carried-parcels
        this.visibleParcels = parcels.filter(p => !p.carriedBy);
        console.log('VISIBLE PARCELS', this.visibleParcels);
    }

    /**
     * Updates visible agents.
     * @param {Array<{ id: string, x: number, y: number }>} agents
     */
    updateVisibleAgents(agents) {
        this.visibleAgents = agents;
    }

    // TODO: find problems, creat error
    /**
     * Updates probability map based on current beliefs.
     * Simplified: for each agent, assume random movement.
     */
    updateProbabilityMap() {
        // Reset map
        for (let x = 0; x < this.mapWidth; x++) {
            for (let y = 0; y < this.mapHeight; y++) {
                for (let t = 0; t < MAX_TIME_HORIZON; t++) {
                    for (let a = 0; a < Math.min(this.visibleAgents.length, MAX_AGENTS); a++) {
                        this.probabilityMap[x][y][t][a] = 0;
                    }
                }
            }
        }

        // For each agent, predict positions
        this.visibleAgents.slice(0, MAX_AGENTS).forEach((agent, index) => {
            let currentX = agent.x;
            let currentY = agent.y;
            this.probabilityMap[Math.floor(currentX)][Math.floor(currentY)][0][index] = 1; // At time 0, certain

            for (let t = 1; t < MAX_TIME_HORIZON; t++) {
                // Simple prediction: equal probability to adjacent cells
                const directions = [
                    { dx: 0, dy: 1 }, // up
                    { dx: 0, dy: -1 }, // down
                    { dx: 1, dy: 0 }, // right
                    { dx: -1, dy: 0 } // left
                ];
                directions.forEach(dir => {
                    const nx = Math.floor(currentX) + dir.dx;
                    const ny = Math.floor(currentY) + dir.dy;
                    if (nx >= 0 && nx < this.mapWidth && ny >= 0 && ny < this.mapHeight) {
                        this.probabilityMap[nx][ny][t][index] += 0.25; // Equal prob
                    }
                });
            }
        });
    }

    /**
     * Defines delivery tiles (type = 2) based on map tiles.
     * @param {Array<{x: number, y: number, type: number}>} tiles
     */
    defineDeliveryPoint(tiles)
    {
        this.deliveryPoint = tiles
            .filter(t => t.type == 2)
            .map(t => ({
                x: t.x,
                y: t.y,
                distance: Math.abs(this.playerPosition.x - t.x) + Math.abs(this.playerPosition.y - t.y)
            }));
        console.log(`[MAP] Delivery points found: ${this.deliveryPoint.length}`);
    }

    /**
     * Defines spawn points (type = 1) based on map tiles.
     * @param {Array<{x: number, y: number, type: number}>} tiles
     */
    defineSpawnPoint(tiles)
    {
        this.spawnPoint = tiles
            .filter(t => t.type == 1)
            .map(t => ({
                x: t.x,
                y: t.y
            }));
        console.log(`[MAP] Spawn points found: ${this.spawnPoint.length}`);
    }

    //-------------------------------------------------------------------------
    // Get and Set method for beliefs attributes
    //-------------------------------------------------------------------------
    /** Gets the player's current position.
    * @returns {{ x: number, y: number }}
    */
    getPlayerPosition() {
        return this.playerPosition;
    }

    /** Gets the set of parcels currently carried.
     * @return {Set<{ id: string }>} Items the player is carrying.
     */
    getCarriedParcels() {
        return this.carried;
    }

    /** Gets the list of visible parcels.
     * @returns {Array<{ id: string, x: number, y: number, carriedBy: string, reward: number }>}
     */
    getVisibleParcels() {
        return this.visibleParcels;
    }

    /** Gets the list of visible agents.
     * @returns {Array<{ id: string, x: number, y: number }>}
     */
    getVisibleAgents() {
        return this.visibleAgents;
    }

    /** Gets the probability map.   
    * @return {Array<Array<Array<Array<number>>>>} Probability map: [x][y][time][agentIndex]
    */
    getProbabilityMap() {
        return this.probabilityMap;
    }

    /** Gets the delivery points.
    * @returns {Array<{ x: number, y: number }>}
    */
    getDeliveryPoint() {
        return this.deliveryPoint;
    }

    /** Gets the spawn points.
    * @returns {Array<{ x: number, y: number }>}
    */
    getSpawnPoint() {
        return this.spawnPoint;
    }



}

// ─── Desires ──────────────────────────────────────────────────────────────────

/**
 * Simple desires:
 * - pickup_x_y (when a parcel is visible)
 * - deliver_x_y (when carrying a parcel)
 * - explore_x_y (go to spawn point)
 */
class Desires {
    constructor() {
        /**
         * Current desires, generated from beliefs. 
         * Format: Map(unicity){<string>, {x: number, y: number, score: number}}
         * @type {Map<string, {type: string, x: number, y: number, score: number }>}
         */
        this.strDesiresMap = new Map(); // to avoid duplicates
    }

    /**
     * Generates all the desires (even if it they are not compatible)
     * Store it in myDesiresSet
     */
    genDesires() {                            
        this.strDesiresMap.clear(); 
        for (let i = 0; i < myBeliefs.getVisibleParcels().length; i++) {
            this?.strDesiresMap.set('pickup_'
                +myBeliefs.getVisibleParcels()[i].x
                +'_'+myBeliefs.getVisibleParcels()[i].y, 
                { 
                    type: 'pickup',
                    x: myBeliefs.getVisibleParcels()[i].x,
                    y: myBeliefs.getVisibleParcels()[i].y,
                    score: 0
                });
        }
        for (let i = 0; i < myBeliefs.getSpawnPoint().length; i++) {
            this?.strDesiresMap.set('explore_'
                +myBeliefs.getSpawnPoint()[i].x
                +'_'+myBeliefs.getSpawnPoint()[i].y, 
                { 
                    type: 'explore',
                    x: myBeliefs.getSpawnPoint()[i].x,
                    y: myBeliefs.getSpawnPoint()[i].y,
                    score: 0
                });
        }

        for (let i = 0; i < myBeliefs.getDeliveryPoint().length; i++) {
            this?.strDesiresMap.set('deliver_'
                +myBeliefs.getDeliveryPoint()[i].x
                +'_'+myBeliefs.getDeliveryPoint()[i].y, 
                { 
                    type: 'deliver',
                    x: myBeliefs.getDeliveryPoint()[i].x,
                    y: myBeliefs.getDeliveryPoint()[i].y,
                    score: 0
                }); 
                // we can encode the delivery point id in the desire for later reference
        }
    }

    /**
     * Gets the desires set
     * @returns {Map<string, {type: string, x: number, y: number, score: number }>}
     */
    getDesires() {
        return this.strDesiresMap;
    }

        
}

// ─── Intentions ───────────────────────────────────────────────────────────────

/**
 * Current intention: the plan being executed.
 */
class Intentions {
    constructor() {
        /** @type {Array<string>} Sequence of actions. */
        this.plan = [];

        /**
         * List of Intentions
         * @type {Array<string>}
         * Ordered list of intentions after filtering 
         */
        this.FilteredIntention = []; 

    }
        
    /**
     * Filters desires into a prioritized sorted list of intentions.
     * Does NOT generate plans or execute actions.
     *
     * Logic:
     *  1. Parse desires into structured objects
     *  2. Eliminate desires incompatible with current beliefs
     *  3. Score each remaining desire via generatePathTo (cost = nb of moves)
     *  4. Sort by score ascending
     *  5. Store sorted desires in FilteredIntention (same format as desires)
     * @param {Map<string, {type: string, x: number, y: number, score: number }>} mapOfDesires - Map of desire strings to filter.
     */
    filterDesiresToSetIntention(mapOfDesires)
    {
        this.FilteredIntention = [];
        const playerPos = myBeliefs.getPlayerPosition();

        // ── 1. Parse desires into structured objects ───────────────────
        const pickupDesires  = [];
        const deliverDesires = [];
        const exploreDesires = [];

        for (const [key, desire] of mapOfDesires) 
        {
            if (desire.type === 'pickup') {
                pickupDesires.push({ ...desire, raw: key });
            } else if (desire.type === 'deliver') {
                deliverDesires.push({ ...desire, raw: key });
            } else if (desire.type === 'explore') {
                exploreDesires.push({ ...desire, raw: key });
            }
        }

        // ── 2. Filter incompatible desires with current beliefs ────────
        // pickup only if parcel is visible and not carried ===> ALREADY CHECK!
        // const validPickups = pickupDesires.filter(d =>
        //     myBeliefs.getVisibleParcels().some(p =>
        //         p.x === d.x && p.y === d.y && !p.carriedBy
        //     )
        // );

        const validPickups = pickupDesires; // already filtered in desires generation
        // deliver only if carrying at least one parcel
        const validDelivers = myBeliefs.getCarriedParcels().size > 0
            ? deliverDesires
            : [];

        // explore only if nothing to pickup and nothing to deliver
        const validExplores = validPickups.length === 0 
                            && validDelivers.length === 0 
                            && myBeliefs.getCarriedParcels().size === 0
            ? exploreDesires
            : [];

        // ── 3. Score each desire via generatePathTo ────────────────────
        const scoreDesires = (desires) =>
            desires.map(d =>
            ({
                ...d,
                cost : generatePathTo(playerPos, { x: d.x, y: d.y }).length
            }));
        const scoredPickups  = scoreDesires(validPickups);
        const scoredDelivers = scoreDesires(validDelivers);
        const scoredExplores = scoreDesires(validExplores);

        // ── 4. Sort each group by cost ascending ──────────────────────
        scoredPickups .sort((a, b) => a.cost - b.cost);
        scoredDelivers.sort((a, b) => a.cost - b.cost);
        scoredExplores.sort((a, b) => a.cost - b.cost);

        // ── 5. Store sorted desires as FilteredIntention ───────────────
        // Priority: pickup >= deliver > explore
        this.FilteredIntention = [
            ...scoredPickups,
            ...scoredDelivers,
            ...scoredExplores
        ];

        console.log(`[INTENTIONS] Filtered intentions:`,
            this.FilteredIntention.map(i => `${i}(cost:${i.cost})`).join(', ')
        );
    }

    /**
     * Sets a new plan.
     * @param {Array<string>} FilteredIntention
     */
    setPlan(FilteredIntention) {
        this.plan = FilteredIntention[0];
        /* supprimer la 1ere attention*/
    }

    /**
     * Gets the next action.
     * @returns {string|null}
     */
    getNextAction() {
        return this.plan.shift() || null;
    }

}

